# Complete list of environment variables the webhook server reads.
# Copy to webhook/.env for local work (.env is gitignored). In production these
# are set in the Railway dashboard, not here. Values below are placeholders.

# ── Required ─────────────────────────────────────────────────────────────────
MEXC_API_KEY=your_mexc_api_key_here
MEXC_SECRET=your_mexc_secret_here
# Gates /balance, /test-telegram and /cockpit/regime via the X-API-Key header.
# Server refuses to start without it.
BALANCE_API_KEY=your_balance_api_key_here

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
# Optional: if set, a TradingView alert body must include "secret": "..."
# matching this value.
WEBHOOK_SECRET=
# Optional: server-side ceiling on per-order risk in USD. Leave unset to use
# the default defined in server.js.
MAX_USD_RISK=

# ── Scanner master kill-switch ───────────────────────────────────────────────
# false (or unset) = detection loop never starts: no MEXC REST bootstrap, no
# WebSocket, no volume/level refresh timers. The webhook server still serves
# /webhook, /balance, /cockpit/regime as normal.
# Set to true and redeploy to run the scanner.
# Note: ALERTS_ENABLED in scanner.js only mutes Telegram — this halts detection.
SCANNER_ENABLED=false

# ── Telegram alerts ──────────────────────────────────────────────────────────
# Used by the scanner's alert sender and by GET /test-telegram.
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ── EchoOo-SAE forwarding ────────────────────────────────────────────────────
# When SAE_FORWARDING_ENABLED=true, scanner SFP/LJ detections POST to /ta-events
# with header X-SAE-Token. Flip to true only after the token is set.
# Independent of Telegram ALERTS_ENABLED in scanner.js.
SAE_FORWARDING_ENABLED=false
SAE_INGEST_TOKEN=your_token_here
SAE_ENDPOINT=https://botbridge-production.up.railway.app/ta-events

# When SAE_REGIME_PUSH_ENABLED=true, POST /cockpit/regime snapshots are
# forwarded to the SAE regime endpoint using the same SAE_INGEST_TOKEN.
SAE_REGIME_PUSH_ENABLED=false
SAE_REGIME_ENDPOINT=https://botbridge-production.up.railway.app/regime/external
